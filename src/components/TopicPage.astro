---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withSiteName } from '../data/site';
import { TOPIC_GROUP_LABELS, getTopic, type Topic } from '../data/topics';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
const c = topic.content;
const groupLabel = TOPIC_GROUP_LABELS[topic.group];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : '/';

const relatedTopics = (c.related ?? [])
  .map((slug) => getTopic(slug))
  .filter((t): t is Topic => Boolean(t));

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  name: c.h1,
  description: c.metaDescription,
  inLanguage: 'id-ID',
  url: canonical,
  about: {
    '@type': 'TouristAttraction',
    name: 'Bukit Indah Simarjarunjung',
    '@id': 'https://bukitsimar.com/#attraction',
  },
  isPartOf: { '@type': 'WebSite', name: 'Bukitsimar', url: 'https://bukitsimar.com/' },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://bukitsimar.com/' },
    { '@type': 'ListItem', position: 2, name: c.h1, item: canonical },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title={withSiteName(c.h1)} description={c.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(webPageLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>

  <header class="site-header">
    <div class="container-site">
      <a class="brand" href="/">Bukit Indah Simarjarunjung</a>
      <nav aria-label="Navigasi utama"><a href="/#topik">Semua topik</a><a href="/">Beranda</a></nav>
    </div>
  </header>

  <main id="main">
    <section class="hero topic-hero">
      <div class="container-site hero-copy">
        <p class="eyebrow">{c.kicker}</p>
        <h1>{c.h1}</h1>
        <p>{c.lead}</p>
        <p class="small">Terakhir diperiksa: {c.updated}. Panduan independen; bukan situs pengelola.</p>
      </div>
    </section>

    {
      c.facts && c.facts.length > 0 && (
        <section class="summary-strip">
          <div class="container-site summary-grid">
            {c.facts.map((f) => (
              <div>
                <h2>{f.label}</h2>
                <p>{f.value}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      c.blocks.map((b) => (
        <section id={b.id} class="section">
          <div class="container-site">
            <p class="eyebrow">{groupLabel}</p>
            <h2>{b.heading}</h2>
            {b.paragraphs && b.paragraphs.map((p) => <p>{p}</p>)}
            {b.bullets && <ul class="topic-bullets">
              {b.bullets.map((li) => <li>{li}</li>)}
            </ul>}
            {b.callout && <p class="topic-callout">{b.callout}</p>}
          </div>
        </section>
      ))
    }

    <section id="faq" class="section pale-section">
      <div class="container-site">
        <p class="eyebrow">FAQ</p>
        <h2>Pertanyaan umum</h2>
        <div class="faq-list">
          {c.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {
      relatedTopics.length > 0 && (
        <section class="section">
          <div class="container-site">
            <p class="eyebrow">Baca juga</p>
            <h2>Panduan terkait</h2>
            <div class="related-grid">
              {relatedTopics.map((t) => (
                <a class="related-card" href={`/${t.slug}/`}>
                  <span class="related-group">{TOPIC_GROUP_LABELS[t.group]}</span>
                  <span class="related-title">{t.content.h1}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>
