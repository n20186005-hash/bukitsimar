---
import '../styles/global.css';
import { SITE_NAME } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const { title, description, image = '/images/hero-simarjarunjung.webp', noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).toString() : image;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173b31" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="id" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <title>{title}</title>
    <script is:inline src="/js/consent.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke isi utama</a>
    <slot />
    <footer class="site-footer"><div class="container-site"><p>Panduan independen Bukit Indah Simarjarunjung; bukan situs pengelola atau layanan pemesanan.</p><nav aria-label="Informasi situs"><a href="/">Panduan</a><a href="/privacy/">Kebijakan Privasi</a><a href="/terms/">Ketentuan Layanan</a><a href="/cookies/">Pengaturan Cookie</a></nav></div></footer>
  </body>
</html>
