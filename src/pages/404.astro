---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withSiteName } from '../data/site';
---
<BaseLayout title={withSiteName('Halaman tidak ditemukan')} description="Halaman tidak ditemukan." noindex={true}><main class="grid min-h-screen place-items-center bg-pine-950 p-6 text-white"><div class="max-w-xl text-center"><p class="text-sm font-bold uppercase tracking-[.25em] text-lake-100">404</p><h1 class="mt-4 font-display text-5xl font-bold">Jalur ini tidak ditemukan.</h1><p class="mt-5 leading-8 text-white/70">Kembali ke panduan utama untuk informasi Bukit Indah Simarjarunjung.</p><a href="/" class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-bold text-pine-900">Kembali ke beranda</a></div></main></BaseLayout>
